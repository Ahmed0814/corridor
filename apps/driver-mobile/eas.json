{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:8000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.staging.example.invalid",
        "EXPO_PUBLIC_AUTH_CLIENT_ID": "SET-IN-EAS-ENVIRONMENT",
        "EXPO_PUBLIC_AUTH_AUTHORIZE_URL": "https://auth.staging.example.invalid/oauth2/authorize",
        "EXPO_PUBLIC_AUTH_TOKEN_URL": "https://auth.staging.example.invalid/oauth2/token"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.example.invalid",
        "EXPO_PUBLIC_AUTH_CLIENT_ID": "SET-IN-EAS-ENVIRONMENT",
        "EXPO_PUBLIC_AUTH_AUTHORIZE_URL": "https://auth.example.invalid/oauth2/authorize",
        "EXPO_PUBLIC_AUTH_TOKEN_URL": "https://auth.example.invalid/oauth2/token"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
