# Example environment for the backend processes (api, realtime, worker, beat).
# Copy to backend/.env for local runs outside Docker. NEVER commit real values.
# In staging/production these come from AWS Secrets Manager via ECS task definitions,
# and backend/.env is never read (config/settings.py).

DJANGO_ENV=development            # development | test | staging | production
DJANGO_SECRET_KEY=                # required outside development/test
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database roles (DECISIONS D-007): requests and tasks run as corridor_app, the audited
# Super Admin path as corridor_platform, migrations as corridor_migrator. None of them owns
# tables or can bypass row-level security. Locally these default to <role>_local passwords.
DATABASE_URL=postgis://corridor_app:CHANGE_ME@localhost:5432/corridor
PLATFORM_DATABASE_URL=postgis://corridor_platform:CHANGE_ME@localhost:5432/corridor
MIGRATOR_DATABASE_URL=postgis://corridor_migrator:CHANGE_ME@localhost:5432/corridor

# Authentication: "local" = development stand-in for Cognito (refused outside development/test).
AUTH_ISSUER_MODE=local
# With Cognito (staging/production):
# AUTH_ISSUER_MODE=cognito
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# COGNITO_CLIENT_IDS=web-office=<id>,web-portal=<id>,driver-mobile=<id>
WEB_ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0

# Celery broker: Amazon SQS in AWS (IAM task role, no keys); ElasticMQ locally.
CELERY_BROKER_URL=sqs://local:local@localhost:9324
SQS_IS_SECURE=false
SQS_QUEUE_PREFIX=corridor-development-
AWS_REGION=me-central-1

LOG_LEVEL=INFO
LOG_FORMAT=console                # console | json

SENTRY_DSN=                       # empty = Sentry disabled
RELEASE=dev

# Windows only, when GDAL/GEOS are not on the system path (docs/development.md):
# GDAL_LIBRARY_PATH=D:/corridor/.devtools/pgsql/bin/libgdal-39.dll
# GEOS_LIBRARY_PATH=D:/corridor/.devtools/pgsql/bin/libgeos_c.dll

# --- web (apps/web) ---
# API_INTERNAL_URL=http://localhost:8000      # server-side calls from Next.js
# SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN         # empty = disabled
