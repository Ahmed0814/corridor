# Example environment for the backend processes (api, realtime, worker, beat).
# Copy to backend/.env for local runs outside Docker. NEVER commit real values.
# In staging/production these come from AWS Secrets Manager via ECS task definitions,
# and backend/.env is never read (config/settings.py).

DJANGO_ENV=development            # development | test | staging | production
DJANGO_SECRET_KEY=                # required outside development/test
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgis://corridor:corridor@localhost:5432/corridor
REDIS_URL=redis://localhost:6379/0

# Celery broker: Amazon SQS in AWS (IAM task role, no keys); ElasticMQ locally.
CELERY_BROKER_URL=sqs://local:local@localhost:9324
SQS_IS_SECURE=false
SQS_QUEUE_PREFIX=corridor-development-
AWS_REGION=me-central-1

LOG_LEVEL=INFO
LOG_FORMAT=console                # console | json

SENTRY_DSN=                       # empty = Sentry disabled
RELEASE=dev

# Windows only, when GDAL/GEOS are not on the system path (docs/development.md):
# GDAL_LIBRARY_PATH=D:/corridor/.devtools/pgsql/bin/libgdal-39.dll
# GEOS_LIBRARY_PATH=D:/corridor/.devtools/pgsql/bin/libgeos_c.dll

# --- web (apps/web) ---
# API_INTERNAL_URL=http://localhost:8000      # server-side calls from Next.js
# SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN         # empty = disabled
