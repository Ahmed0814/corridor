# Corridor single-host test stack (DECISIONS D-072). Generated by Terraform; do not edit on the host.
# Secrets come from /opt/corridor/secrets.env (written at boot from SSM, mode 600).
name: corridor

x-backend: &backend
  image: ${backend_image}
  env_file: [/opt/corridor/secrets.env]
  environment: &backend-env
    DJANGO_ENV: ${environment}
    DJANGO_ALLOWED_HOSTS: ${hostname},api,realtime,localhost
    LOG_FORMAT: json
    AUTH_ISSUER_MODE: cognito
    COGNITO_ISSUER: ${cognito_issuer}
    COGNITO_USER_POOL_ID: ${cognito_pool_id}
    COGNITO_REGION: ${region}
    COGNITO_CLIENT_IDS: web-office=${client_office},web-portal=${client_portal},driver-mobile=${client_driver}
    WEB_ALLOWED_ORIGINS: https://${hostname}
    AWS_REGION: ${region}
    REDIS_URL: redis://redis:6379/0
    # Broker: ElasticMQ on the host (SQS-compatible, no AWS cost). Dummy keys are required by the
    # SQS client and never reach AWS.
    CELERY_BROKER_URL: sqs://local:local@elasticmq:9324
    SQS_IS_SECURE: "false"
    SQS_QUEUE_PREFIX: corridor-${environment}-
    # Files stay on the encrypted volume (no S3 cost); snapshots back them up.
    DOCUMENT_STORAGE_BACKEND: local
    DOCUMENT_STORAGE_DIR: /data/documents
    GPS_ARCHIVE_BACKEND: local
    GPS_ARCHIVE_DIR: /data/gps-archive
    # Real email is not approved (MASTER_PROMPT §0.3): suppressed and logged only.
    EMAIL_SENDING_ENABLED: "false"
    EMAIL_BACKEND: django.core.mail.backends.console.EmailBackend
    # TLS ends at Caddy on the same host.
    SECURE_SSL_REDIRECT: "false"
  volumes:
    - appdata:/data
  depends_on: &backend-deps
    db: { condition: service_healthy }
    redis: { condition: service_healthy }
    elasticmq: { condition: service_started }
    migrate: { condition: service_completed_successfully }
  restart: unless-stopped
  logging: &logging
    driver: json-file
    options: { max-size: "10m", max-file: "3" }

services:
  db:
    # postgis/postgis has no arm64 build: official postgres:16 + PostGIS from the PGDG apt repo,
    # built on the host (Dockerfile written at boot).
    build: /opt/corridor/postgis
    image: corridor-postgis:16
    env_file: [/opt/corridor/db.env]
    environment:
      POSTGRES_DB: corridor
      POSTGRES_USER: postgres
    command: ["postgres", "-c", "shared_buffers=128MB", "-c", "max_connections=60",
              "-c", "work_mem=4MB", "-c", "maintenance_work_mem=64MB"]
    volumes:
      - pgdata:/var/lib/postgresql/data
      - /opt/corridor/db-init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d corridor"]
      interval: 5s
      timeout: 3s
      retries: 30
    restart: unless-stopped
    logging: *logging

  redis:
    image: redis:7.4-alpine
    command: ["redis-server", "--maxmemory", "64mb", "--maxmemory-policy", "allkeys-lru", "--save", ""]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
    restart: unless-stopped
    logging: *logging

  elasticmq:
    image: softwaremill/elasticmq-native:1.7.1
    volumes:
      - /opt/corridor/elasticmq.conf:/opt/elasticmq.conf:ro
    restart: unless-stopped
    logging: *logging

  migrate:
    <<: *backend
    # Migrations run as corridor_migrator (secrets.env: MIGRATOR_DATABASE_URL), never as the app role.
    entrypoint: ["sh", "-c", "DATABASE_URL=\"$$MIGRATOR_DATABASE_URL\" exec python manage.py migrate --noinput"]
    depends_on:
      db: { condition: service_healthy }
    restart: "no"

  api:
    <<: *backend
    command: ["uvicorn", "config.asgi:application", "--host", "0.0.0.0", "--port", "8000",
              "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]

  realtime:
    <<: *backend
    command: ["daphne", "-b", "0.0.0.0", "-p", "8001", "--proxy-headers", "config.asgi:application"]
    healthcheck:
      test: ["CMD", "python", "-c", "import socket; socket.create_connection(('127.0.0.1', 8001), 2)"]
      interval: 15s
      timeout: 3s
      retries: 10

  worker:
    <<: *backend
    command: ["celery", "-A", "config", "worker", "-Q", "default,events", "--loglevel", "INFO",
              "--concurrency", "1"]
    healthcheck: { disable: true }

  beat:
    <<: *backend
    command: ["celery", "-A", "config", "beat", "--loglevel", "INFO", "--schedule", "/tmp/celerybeat-schedule"]
    healthcheck: { disable: true }

  web:
    image: ${web_image}
    environment:
      API_INTERNAL_URL: http://api:8000
      AUTH_AUTHORIZE_URL: ${cognito_domain}/oauth2/authorize
      AUTH_TOKEN_URL: ${cognito_domain}/oauth2/token
      AUTH_LOGOUT_URL: ${cognito_domain}/logout
      AUTH_CLIENT_ID_OFFICE: ${client_office}
      AUTH_CLIENT_ID_PORTAL: ${client_portal}
      APP_BASE_URL: https://${hostname}
    depends_on:
      api: { condition: service_started }
    restart: unless-stopped
    logging: *logging

  caddy:
    image: caddy:2.10-alpine
    ports: ["80:80", "443:443"]
    volumes:
      - /opt/corridor/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddydata:/data
    depends_on: [web, api, realtime]
    restart: unless-stopped
    logging: *logging

volumes:
  pgdata:
  appdata:
  caddydata:
