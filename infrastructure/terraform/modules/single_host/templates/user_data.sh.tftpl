#!/bin/bash
# First-boot setup of the Corridor single-host test environment (DECISIONS D-072).
# Generated by Terraform. Contains no secrets: they are read from SSM Parameter Store below.
set -euo pipefail
exec > >(tee -a /var/log/corridor-bootstrap.log) 2>&1
echo "corridor bootstrap start $(date -Is)"

REGION="${region}"
PREFIX="${param_prefix}"
COMPOSE_VERSION="v2.40.3"

# --- OS: updates, Docker, 2 GB swap (2 GB RAM is tight for the whole stack) -------------------
dnf -y upgrade --refresh
dnf -y install docker
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
cd /tmp
curl -fsSLO "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-aarch64"
curl -fsSLO "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-aarch64.sha256"
sha256sum -c docker-compose-linux-aarch64.sha256
install -m 0755 docker-compose-linux-aarch64 /usr/local/lib/docker/cli-plugins/docker-compose

if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  echo "/swapfile none swap defaults 0 0" >> /etc/fstab
fi
swapon -a || true

# --- files ------------------------------------------------------------------------------------
install -d -m 0755 /opt/corridor /opt/corridor/db-init /opt/corridor/postgis
echo "${compose_b64}"    | base64 -d | gunzip > /opt/corridor/compose.yml
echo "${caddyfile_b64}"  | base64 -d | gunzip > /opt/corridor/Caddyfile
echo "${elasticmq_b64}"  | base64 -d | gunzip > /opt/corridor/elasticmq.conf
echo "${extensions_b64}" | base64 -d | gunzip > /opt/corridor/db-init/01-extensions.sql
echo "${roles_sh_b64}"   | base64 -d | gunzip > /opt/corridor/db-init/02-roles.sh
echo "${roles_sql_b64}"  | base64 -d | gunzip > /opt/corridor/db-init/bootstrap_roles.sql.inc
chmod 0755 /opt/corridor/db-init/02-roles.sh

cat > /opt/corridor/postgis/Dockerfile <<'DOCKERFILE'
FROM postgres:16-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-16-postgis-3 \
 && rm -rf /var/lib/apt/lists/*
DOCKERFILE

# --- secrets from SSM (SecureString, decrypted with the instance role) ------------------------
param() {
  aws ssm get-parameter --region "$REGION" --with-decryption --name "$PREFIX/$1" \
    --query Parameter.Value --output text
}
umask 077
DB_POSTGRES="$(param db_postgres_password)"
DB_MIGRATOR="$(param db_migrator_password)"
DB_APP="$(param db_app_password)"
DB_RELAY="$(param db_relay_password)"
DB_PLATFORM="$(param db_platform_password)"

cat > /opt/corridor/db.env <<EOF
POSTGRES_PASSWORD=$${DB_POSTGRES}
CORRIDOR_MIGRATOR_PASSWORD=$${DB_MIGRATOR}
CORRIDOR_APP_PASSWORD=$${DB_APP}
CORRIDOR_RELAY_PASSWORD=$${DB_RELAY}
CORRIDOR_PLATFORM_PASSWORD=$${DB_PLATFORM}
EOF

cat > /opt/corridor/secrets.env <<EOF
DJANGO_SECRET_KEY=$(param django_secret_key)
FIELD_ENCRYPTION_KEYS=$(param field_encryption_key)
DATABASE_URL=postgis://corridor_app:$${DB_APP}@db:5432/corridor
PLATFORM_DATABASE_URL=postgis://corridor_platform:$${DB_PLATFORM}@db:5432/corridor
RELAY_DATABASE_URL=postgis://corridor_relay:$${DB_RELAY}@db:5432/corridor
MIGRATOR_DATABASE_URL=postgis://corridor_migrator:$${DB_MIGRATOR}@db:5432/corridor
EOF
chmod 600 /opt/corridor/db.env /opt/corridor/secrets.env
umask 022

# --- start on every boot ----------------------------------------------------------------------
cat > /etc/systemd/system/corridor.service <<'UNIT'
[Unit]
Description=Corridor test stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/corridor
ExecStart=/usr/bin/docker compose -f /opt/corridor/compose.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/corridor/compose.yml down
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now corridor.service
echo "corridor bootstrap done $(date -Is)"
